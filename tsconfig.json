{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["DOM", "ES2020"],
    "outDir": "./dist",
    "rootDir": "./assets/js",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["assets/js/**/*.ts"]
}
